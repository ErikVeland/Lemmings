[Unit]
Description=Ultimate Lemmings anonymous rescue counts
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=lemmings-telemetry
StateDirectoryMode=0700
WorkingDirectory=/opt/lemmings-telemetry
EnvironmentFile=/etc/lemmings-telemetry.env
ExecStart=/usr/bin/python3 -B /opt/lemmings-telemetry/server.py --db /var/lib/lemmings-telemetry/counts.sqlite3 --port 8796
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=128M
CPUQuota=25%
TasksMax=40
LimitNOFILE=128
UMask=0077

[Install]
WantedBy=multi-user.target
