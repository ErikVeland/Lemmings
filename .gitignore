# Commercial game data. Never commit. The player imports data they own.
Content
Sources/Music
Sources/Ports
Sources/lemmings_*/
*.mod
*.ipf
*.adf
*.dms
*.dat
*.DAT
*.exe
*.EXE

# Build output
.build/
main
*.app
*.swiftmodule
*.swiftdoc
*.swiftsourceinfo
*.abi.json
*.dylib
*.o

# Sparkle framework downloads. The pinned copy lives in .build/dependencies
# via Scripts/ensure-sparkle.sh; never commit a manual download.
/Sparkle-*/

# Local archive of superseded documentation. Current release and design docs stay tracked.
.archive/
/Documentation/ReleaseReadiness/**/build/

# macOS
.DS_Store

# Private signing and provisioning inputs. Never commit.
*.p8
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
*.provisionprofile

# Python bytecode from the one-time asset import tools.
__pycache__/

# Claude Code worktrees are their own checkouts, not content of this one.
.claude/worktrees/

# Posts and other transitory write-ups live outside the repo, in
# ~/Documents/Ultimate Lemmings/Posts.
*.bbcode.txt
*BBCode*.txt
Documentation/ForumPost-*
Documentation/ForumThread-*
Documentation/Threads*

