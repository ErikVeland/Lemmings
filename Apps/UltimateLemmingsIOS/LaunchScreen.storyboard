<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24516" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="startup-controller">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24511"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="startup-scene">
            <objects>
                <viewController id="startup-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="startup-background">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="StartupLogo" translatesAutoresizingMaskIntoConstraints="NO" id="startup-logo">
                                <rect key="frame" x="24" y="360" width="345" height="91"/>
                                <constraints>
                                    <constraint firstAttribute="width" secondItem="startup-logo" secondAttribute="height" multiplier="1440:380" id="logo-aspect"/>
                                    <constraint firstAttribute="width" relation="lessThanOrEqual" constant="640" id="logo-limit"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="startup-safe"/>
                        <color key="backgroundColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        <constraints>
                            <constraint firstItem="startup-logo" firstAttribute="centerX" secondItem="startup-safe" secondAttribute="centerX" id="logo-center-x"/>
                            <constraint firstItem="startup-logo" firstAttribute="centerY" secondItem="startup-safe" secondAttribute="centerY" constant="-28" id="logo-center-y"/>
                            <constraint firstItem="startup-logo" firstAttribute="width" secondItem="startup-safe" secondAttribute="width" constant="-48" priority="750" id="logo-width"/>
                            <constraint firstItem="startup-logo" firstAttribute="height" relation="lessThanOrEqual" secondItem="startup-safe" secondAttribute="height" constant="-100" id="logo-height"/>
                            <constraint firstItem="startup-logo" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="startup-safe" secondAttribute="leading" constant="24" id="logo-leading"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="startup-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="StartupLogo" width="1440" height="380"/>
    </resources>
</document>
